# Virasat — required environment variables
# There was no .env / .env.example in the repo before, so this documents what
# server/_core/env.ts actually reads. Copy to .env for local dev, or set these
# in your Manus project's environment settings for the live deployment.

# --- Provided automatically by the Manus platform when deployed there ---
# You should not need to set these by hand on a real Manus deployment; they
# only need manual values for local/sandbox testing off-platform.
VITE_APP_ID=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Database (optional but recommended) ---
# If unset, every query falls back to static mock data (server/virasatMock.ts)
# instead of erroring — safe for a demo, but nothing persists. Set this to a
# real MySQL/MariaDB connection string to make claims/documents/assets/users
# genuinely save. See SETUP.md for the exact commands to install and start
# MariaDB locally — this is the format it expects:
DATABASE_URL=mysql://virasat:CHANGE_ME@127.0.0.1:3306/virasat

# --- Frontend build flag (this is the important one) ---
# Controls whether the React app calls the real tRPC backend or stays on
# client-side mock data (client/src/services/dataService.ts). Was previously
# unset everywhere in this repo, which silently forced every page — including
# the whole Claim Assist flow — onto mock data with no real network calls.
# Set to "true" once OAUTH_SERVER_URL (for login) is confirmed working, so the
# real claims.create / claims.addDocument / claims.parseDocument / etc. calls
# are actually exercised. Every page still falls back to mock data gracefully
# if a real call 401s or fails, so it's safe to enable even before login is
# fully wired — see AUDIT_FOLLOWUP.md for what to verify before a live demo.
VITE_USE_BACKEND=true
